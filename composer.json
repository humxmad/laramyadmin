{
    "name": "laramyadmin/laramyadmin",
    "description": "A modern, beautiful, multi-database management package for Laravel (phpMyAdmin / TablePlus alternative).",
    "keywords": ["laravel", "database", "phpmyadmin", "adminer", "tableplus", "mysql", "postgres", "sqlite", "sql"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Hammad Siddiqui",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/session": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "orchestra/workbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "LaraMyAdmin\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LaraMyAdmin\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "./vendor/bin/phpunit",
        "setup": [
            "@php ./vendor/bin/testbench workbench:create-sqlite-db",
            "@php ./vendor/bin/testbench migrate --seed"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php ./vendor/bin/testbench serve --port=8080"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LaraMyAdmin\\LaraMyAdminServiceProvider"
            ],
            "aliases": {
                "LaraMyAdmin": "LaraMyAdmin\\Facades\\LaraMyAdmin"
            }
        },
        "workbench": {
            "start": "/laramyadmin"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
